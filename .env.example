# ---- Server ----
PORT=8080
HOST=0.0.0.0
# Public URL of this dashboard. Used for the "click" action on ntfy notifications.
PUBLIC_URL=http://raspberrypi.local:8080

# Dashboard password. Leave blank to disable auth, which leaves the API open to
# anyone who can reach this port -- they can read every monitor target and make
# this server issue requests to hosts it can reach. Fine on a trusted LAN; set a
# password before exposing it any wider.
AUTH_PASSWORD=

# Set to "true" only when behind a reverse proxy you control that sets
# X-Forwarded-For. It makes rate limits key on the real client IP. Leaving it on
# without such a proxy lets clients spoof their address and evade throttling.
TRUST_PROXY=

# SSRF guard. When true (default), reject monitor targets whose host is a
# literal loopback / RFC1918 / link-local / cloud-metadata IP. Set to "false"
# only when you need to monitor hosts on your LAN -- a typical homelab has
# every monitor target in 192.168.x.x. A hostname that resolves to a private
# IP is caught at fetch time regardless of this flag.
BLOCK_PRIVATE_TARGETS=true

# ---- Storage ----
DATA_DIR=./data
# Delete individual check rows older than this. Incidents are kept forever.
RETENTION_DAYS=30

# ---- ntfy ----
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=unraid-uptime-CHANGE-ME
# Optional: access token for protected topics (self-hosted ntfy or ntfy.sh Pro)
NTFY_TOKEN=
# Priority: 1=min 2=low 3=default 4=high 5=urgent
NTFY_DOWN_PRIORITY=5
NTFY_UP_PRIORITY=3

# ---- Dead-man's-switch ----
# Nothing watches this process. If the host loses power or the process wedges,
# no alert is ever sent and silence looks exactly like "everything is fine".
# Point this at a healthchecks.io check (or any URL that notices absence) and it
# is pinged on a schedule -- that service alerts you when the pings stop.
# It is withheld when the check loop has stalled, so a live-but-stuck process
# still trips the alarm. Empty disables it.
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_S=60
HEARTBEAT_METHOD=GET
HEARTBEAT_TIMEOUT_MS=10000

# ---- Defaults applied to newly created monitors ----
DEFAULT_INTERVAL_S=60
DEFAULT_TIMEOUT_MS=10000
DEFAULT_RETRIES=2
# How long a monitor must stay down before the FIRST alert fires ("down for too long")
DEFAULT_ALERT_AFTER_S=120
# Re-alert every N seconds while still down. 0 disables reminders.
DEFAULT_REMINDER_EVERY_S=1800
